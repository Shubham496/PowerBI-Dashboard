		displayFolder: Quantity & Returns
		lineageTag: a1b2c3d4-1111-4000-8000-000000000005

	measure 'Is High Risk Return Product' = IF([CY Return Quantity] > 10 && [Return Rate] > 0.02, 1, 0)
		formatString: 0
		displayFolder: Quantity & Returns
		lineageTag: a1b2c3d4-1111-4000-8000-000000000006

	measure 'Customer Lifetime Sales' = CALCULATE(SUMX(Sales, Sales[OrderQuantity] * Sales[ProductPrice]), REMOVEFILTERS('Calander'))
		formatString: \$#,##0.00;(\$#,##0.00);\$0.00
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000001

	measure 'Customer Total Orders' = CALCULATE(DISTINCTCOUNT(Sales[OrderNumber]), REMOVEFILTERS('Calander'))
		formatString: #,##0
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000002

	measure 'Customer Total Units' = CALCULATE(SUM(Sales[OrderQuantity]), REMOVEFILTERS('Calander'))
		formatString: #,##0
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000003

	measure 'Customer First Order Date' = CALCULATE(MIN(Sales[OrderDate]), REMOVEFILTERS('Calander'))
		formatString: yyyy-mm-dd
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000004

	measure 'Customer Last Order Date' = CALCULATE(MAX(Sales[OrderDate]), REMOVEFILTERS('Calander'))
		formatString: yyyy-mm-dd
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000005

	measure 'Customer Days Since Last Order' =
			VAR LastDate = [Customer Last Order Date]
			RETURN
			IF(NOT ISBLANK(LastDate), DATEDIFF(LastDate, TODAY(), DAY), BLANK())
		formatString: #,##0
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000006

	measure 'Customer Lifetime Return Units' = CALCULATE(SUM('Returns Data'[ReturnQuantity]), REMOVEFILTERS('Calander'))
		formatString: #,##0
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000007

	measure 'Customer Lifetime Return Rate' = DIVIDE([Customer Lifetime Return Units], [Customer Total Units], 0)
		formatString: 0.00%
		displayFolder: Customers
		lineageTag: b2c3d4e5-2222-4000-8000-000000000008

