	measure 'CY New Customers' = ```
			VAR CustomersInPeriod = VALUES(Sales[CustomerKey])
			VAR MinSelectedDate = MIN('Calander'[Date])
			VAR MaxSelectedDate = MAX('Calander'[Date])
			RETURN
			COUNTROWS(
			    FILTER(
			        CustomersInPeriod,
			        VAR FirstEverDate = 
			            CALCULATE(
			                MIN(Sales[OrderDate]), 
			                REMOVEFILTERS('Calander')
			            )
			        RETURN
			            FirstEverDate >= MinSelectedDate && FirstEverDate <= MaxSelectedDate
			    )
			)
			```
		formatString: #,##0
		displayFolder: Customers
		lineageTag: d928bc31-e123-4567-89ab-cdef01234567

	measure 'CY Lost Customers' = ```
			VAR CurrentCustomers = VALUES(Sales[CustomerKey])
			VAR PriorYearCustomers = 
			    CALCULATETABLE(
			        VALUES(Sales[CustomerKey]),
			        SAMEPERIODLASTYEAR('Calander'[Date])
			    )
			RETURN
			COUNTROWS(
			    EXCEPT(PriorYearCustomers, CurrentCustomers)
			)
			```
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 5b6c7d8e-9fa0-1b2c-3d4e-5f6a7b8c9d0e

	measure 'Customer Retention Rate' = ```
			VAR PriorYearCustomers = 
			    CALCULATETABLE(
			        VALUES(Sales[CustomerKey]),
			        SAMEPERIODLASTYEAR('Calander'[Date])
			    )
			VAR RetainedCustomers = 
			    CALCULATETABLE(
			        VALUES(Sales[CustomerKey]),
			        PriorYearCustomers
			    )
			RETURN
			DIVIDE(COUNTROWS(RetainedCustomers), COUNTROWS(PriorYearCustomers), 0)
			```
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d

