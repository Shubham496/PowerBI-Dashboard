	partition _ = calculated
		mode: import
		source = ```
				
				VAR MinDate = MIN(Sales[OrderDate])
				VAR MaxDate = MAX(Sales[OrderDate])
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Short Month", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Quarter-Year", "Q" & FORMAT([Date], "Q") & "-" & YEAR([Date]),
				    "Day", DAY([Date]),
				    "Day Name", FORMAT([Date], "DDDD"),
				    "Short Day", FORMAT([Date], "DDD"),
				    "Day of Week", WEEKDAY([Date], 2),
				    "Week Number", WEEKNUM([Date], 2),
				    "Is Weekend", IF(WEEKDAY([Date], 2) > 5, "Yes", "No"),
				    "Month Start", DATE(YEAR([Date]), MONTH([Date]), 1),
				    "Month End", EOMONTH([Date], 0),
				    "Year Start", DATE(YEAR([Date]), 1, 1),
				    "Year End", DATE(YEAR([Date]), 12, 31)
				)
				
				```

	annotation PBI_Id = 9d9f0173e2bf448bb546ccbeaa134a4e

