{
  "profile": "tabular-data-package",
  "name": "adventureworks-csv",
  "title": "AdventureWorks CSV Data",
  "description": "Shared schema and resource manifest for the AdventureWorks CSV files.",
  "resources": [
    {
      "name": "calendar-lookup",
      "path": "AdventureWorks Calendar Lookup.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "Date", "type": "date", "format": "%Y-%m-%d" }
        ],
        "primaryKey": "Date"
      }
    },
    {
      "name": "customer-lookup",
      "path": "AdventureWorks Customer Lookup.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "CustomerKey", "type": "integer" },
          { "name": "Prefix", "type": "string" },
          { "name": "FirstName", "type": "string" },
          { "name": "LastName", "type": "string" },
          { "name": "BirthDate", "type": "date", "format": "%Y-%m-%d" },
          { "name": "MaritalStatus", "type": "string" },
          { "name": "Gender", "type": "string" },
          { "name": "EmailAddress", "type": "string", "format": "email" },
          { "name": "AnnualIncome", "type": "integer" },
          { "name": "TotalChildren", "type": "integer" },
          { "name": "EducationLevel", "type": "string" },
          { "name": "Occupation", "type": "string" },
          { "name": "HomeOwner", "type": "string" }
        ],
        "primaryKey": "CustomerKey"
      }
    },
    {
      "name": "product-category-lookup",
      "path": "AdventureWorks Product Categories Lookup.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "ProductCategoryKey", "type": "integer" },
          { "name": "CategoryName", "type": "string" }
        ],
        "primaryKey": "ProductCategoryKey"
      }
    },
    {
      "name": "product-lookup",
      "path": "AdventureWorks Product Lookup.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "ProductKey", "type": "integer" },
          { "name": "ProductSubcategoryKey", "type": "integer" },
          { "name": "ProductSKU", "type": "string" },
          { "name": "ProductName", "type": "string" },
          { "name": "ModelName", "type": "string" },
          { "name": "ProductDescription", "type": "string" },
          { "name": "ProductColor", "type": "string" },
          { "name": "ProductSize", "type": "string" },
          { "name": "ProductStyle", "type": "string" },
          { "name": "ProductCost", "type": "number" },
          { "name": "ProductPrice", "type": "number" }
        ],
        "primaryKey": "ProductKey",
        "foreignKeys": [
          {
            "fields": "ProductSubcategoryKey",
            "reference": {
              "resource": "product-subcategory-lookup",
              "fields": "ProductSubcategoryKey"
            }
          }
        ]
      }
    },
    {
      "name": "product-subcategory-lookup",
      "path": "AdventureWorks Product Subcategories Lookup.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "ProductSubcategoryKey", "type": "integer" },
          { "name": "SubcategoryName", "type": "string" },
          { "name": "ProductCategoryKey", "type": "integer" }
        ],
        "primaryKey": "ProductSubcategoryKey",
        "foreignKeys": [
          {
            "fields": "ProductCategoryKey",
            "reference": {
              "resource": "product-category-lookup",
              "fields": "ProductCategoryKey"
            }
          }
        ]
      }
    },
    {
